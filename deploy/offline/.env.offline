PORT=8000
# To allow other LAN computers to access, change compose port binding or set BIND_ADDRESS=0.0.0.0.
BIND_ADDRESS=127.0.0.1
API_KEY=
PRELOAD_MODEL=true
DTYPE=auto
BATCH_SIZE=1
OMP_NUM_THREADS=6
MKL_NUM_THREADS=6
MAX_LENGTH=2048
THRESHOLD=0.85
MAX_CONTRADICTION=0.10
MATCH_MODE=directional
KEYWORD_MODE=any
KEYWORD_CASE_SENSITIVE=true
GUNICORN_TIMEOUT=600
