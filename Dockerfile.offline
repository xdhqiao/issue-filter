# The runtime image is built from the repository's regular Dockerfile first.
ARG RUNTIME_IMAGE=issue-filter-runtime:20261104-cpu
FROM ${RUNTIME_IMAGE}
USER root
# Named build context supplies exactly the already downloaded checkpoint.
COPY --from=model --chown=appuser:appuser / /models/qwen3.5-4b-nli-v5/
ENV MODEL_PATH=/models/qwen3.5-4b-nli-v5 \
    LOCAL_FILES_ONLY=true \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PRELOAD_MODEL=true \
    DEVICE=cpu \
    DTYPE=auto \
    QUANTIZATION=none \
    BATCH_SIZE=1 \
    OMP_NUM_THREADS=6 \
    MKL_NUM_THREADS=6
LABEL org.opencontainers.image.title="Issue Filter offline with Qwen3.5-4B-NLI-v5" \
      org.opencontainers.image.description="Application, Python dependencies, OS layers and local NLI weights" \
      issue-filter.model-revision="5df9876e03397de71504a8f156509e6529c263d8"
USER appuser
