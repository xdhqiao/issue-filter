# Docker Compose reads this file after you copy it to .env.
# Native Python/Waitress does NOT automatically load .env; export variables there.
PORT=8000
API_KEY=
MODEL_ID=AlexWortega/openjev
MODEL_SUBFOLDER=qwen3.5-4b-nli-v5
MODEL_REVISION=5df9876e03397de71504a8f156509e6529c263d8
# A local checkpoint folder takes precedence over MODEL_ID/SUBFOLDER/REVISION.
MODEL_PATH=
LOCAL_FILES_ONLY=false
PRELOAD_MODEL=true
DTYPE=auto
# Used by the GPU overlay; base Compose always uses CPU and no quantization.
QUANTIZATION=none
BATCH_SIZE=4
MAX_LENGTH=2048
THRESHOLD=0.85
MAX_CONTRADICTION=0.10
MATCH_MODE=directional
KEYWORD_MODE=any
KEYWORD_CASE_SENSITIVE=true
MAX_DESCRIPTION_CHARS=8000
MAX_CANDIDATES=1000
MAX_CONTENT_LENGTH=4194304
INFERENCE_LOCK_TIMEOUT=1
GUNICORN_TIMEOUT=600
